# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Bot Owner ID (Gelişmiş admin komutlarını kullanacak kişinin Discord kullanıcı ID'si)
OWNER_ID=your_discord_user_id_here

# Pterodactyl Client API
PTERODACTYL_URL=https://panel.yourdomain.com
PTERODACTYL_API_KEY=ptlc_your_client_api_key_here

# Özel Host İstatistikleri API URL'si
HOST_STATS_URL=http://localhost:3000

